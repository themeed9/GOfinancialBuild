# Copy to mobile/.env.local (never committed) or set as GitHub repository
# variables for the Android test build. Values come from the Firebase console:
# Project settings → Your apps → Web app. Leave empty to run without Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
